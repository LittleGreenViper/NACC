    "SLUG-ONLY-SHOW-KEYTAGS-HINT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a keytag instead of a medallion after one year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nach einem Jahr einen Schlüsselanhänger statt einer Medaille."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από ένα έτος εμφανίζει μπρελόκ αντί για μετάλλιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un llavero en lugar de un medallón después de un año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un porte-clés à la place d’un médaillon après un an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un anno mostra un portachiavi al posto di un medaglione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após um ano, mostra um chaveiro em vez de um medalhão."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un llavero en lugar de un medallón después de un año."
          }
        }
