        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el informe de tiempo limpio sin imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le rapport de temps d’abstinence sans image."
