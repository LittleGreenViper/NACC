    "SLUG-ONLY-SHOW-TEXT-HINT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the cleantime report without an image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Cleanzeitbericht ohne Bild."
